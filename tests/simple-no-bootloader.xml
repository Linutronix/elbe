<ns0:RootFileSystem xmlns:ns0="https://www.linutronix.de/projects/Elbe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" created="2009-05-20T08:50:56" revision="6" xsi:schemaLocation="https://www.linutronix.de/projects/Elbe dbsfed.xsd">
	<project>
		<name>simple-no-bootloader</name>
		<version>1.0</version>
		<description>
			Minimal bootable amd64 image without a bootloader in the image:
			qemu boots the extracted kernel/initrd directly
			(-kernel/-initrd).
		</description>
		<buildtype>amd64</buildtype>
		<mirror>
			<primary_host>deb.debian.org</primary_host>
			<primary_path>/debian</primary_path>
			<primary_proto>http</primary_proto>
		</mirror>
		<suite>trixie</suite>
	</project>
	<target>
		<hostname>no-bootloader</hostname>
		<domain>elbe-ci</domain>
		<passwd>root</passwd>
		<console>ttyS0,115200</console>

		<images>
			<msdoshd>
				<name>sda.img</name>
				<size>2000MiB</size>
				<partition>
					<size>remain</size>
					<label>rfs</label>
				</partition>
			</msdoshd>
		</images>

		<fstab>
			<bylabel>
				<label>rfs</label>
				<mountpoint>/</mountpoint>
				<fs><type>ext4</type></fs>
			</bylabel>
		</fstab>

		<pkg-list>
			<pkg>linux-image-amd64</pkg>
		</pkg-list>

		<install-recommends />

		<finetuning>
			<artifact>/vmlinuz</artifact>
			<artifact>/initrd.img</artifact>
		</finetuning>

		<project-finetuning>
			<set_packer packer="none">sda.img</set_packer>
		</project-finetuning>
	</target>
	<check-image-list>
		<check>
			<img>sda.img</img>
			<interpreter>qemu-system-x86_64</interpreter>
			<interpreter-opts>-m 2G -enable-kvm -cpu host -drive format=raw,file=$ELBE_IMG -kernel vmlinuz -initrd initrd.img -append "console=ttyS0,115200 root=/dev/sda1" -nographic</interpreter-opts>
			<action><login>root</login></action>
		</check>
	</check-image-list>
</ns0:RootFileSystem>
